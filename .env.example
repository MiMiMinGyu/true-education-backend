PORT=4000
NODE_ENV=development

# 세션 쿠키 서명에 사용. 운영 환경에서는 반드시 무작위의 긴 값으로 교체할 것.
SESSION_SECRET=change-this-secret

# 프론트엔드 오리진 (CORS + 쿠키 credentials 허용 대상)
CORS_ORIGIN=http://localhost:3000

# 로컬 PostgreSQL (docker compose). 호스트 포트는 다른 로컬 DB와 겹치지 않게 5434
POSTGRES_USER=yeoul
POSTGRES_PASSWORD=yeoul
POSTGRES_DB=true_education
POSTGRES_PORT=5434
DATABASE_URL=postgresql://yeoul:yeoul@localhost:5434/true_education?schema=public

# 파일 저장소(표지 그림·TTS 음성). local = 서버 디스크(STORAGE_LOCAL_DIR)에 저장하고 /files로 제공, s3 = 운영
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage
# 파일 URL 앞부분(프론트가 다른 오리진이므로 절대 URL). s3면 CloudFront 주소(필수, /files/*가 S3로 연결됨)
PUBLIC_BASE_URL=http://localhost:4000
# s3 드라이버 전용. 자격 증명은 넣지 않습니다(운영 = EC2 IAM 역할, SDK 기본 체인).
# S3_BUCKET=
# AWS_REGION=ap-northeast-2
# 객체 키 앞 폴더(기본 files/ → CloudFront /files/* 경로와 같음)
# S3_KEY_PREFIX=files/
# S3 호환 저장소 주소(로컬 MinIO 검증용). 운영에서는 비워 둡니다.
# S3_ENDPOINT=

# Typecast TTS(여울이 차례 음성). 비어 있으면 음성 API가 503(음성 없이 진행)을 돌려줍니다.
# 목소리 ID·모델명은 Typecast 콘솔에서 확인. 키는 백엔드만 보유하고 커밋하지 않습니다.
TYPECAST_API_KEY=
TYPECAST_VOICE_ID=
TYPECAST_MODEL=

# AI 파트가 서버로 동화를 보내는 API(POST /admin/books) 키. 비어 있으면 그 경로는 404(꺼짐).
# 운영에서는 openssl rand -hex 32 로 만든 값을 SSM에 두고 AI 파트에만 전달합니다.
CONTENT_API_KEY=
# 동화 부족 알림 웹훅(디스코드·슬랙 수신 웹훅 주소). 비어 있으면 서버 로그로만 남깁니다.
CONTENT_ALERT_WEBHOOK_URL=

# AI 파트 생성 파이프라인(production_api.py, Tailscale 사설망 주소). 둘 다 있어야 서버가 5분마다 검증된 책을 가져옵니다.
# 토큰은 백엔드만 보유(로그·응답에 남기지 않음). 수동: npm run pipeline -- sync
AI_PIPELINE_URL=
AI_PIPELINE_TOKEN=
