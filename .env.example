PORT=4000
NODE_ENV=development

# 세션 쿠키 서명에 사용. 운영 환경에서는 반드시 무작위의 긴 값으로 교체할 것.
SESSION_SECRET=change-this-secret

# 프론트엔드 오리진 (CORS + 쿠키 credentials 허용 대상)
CORS_ORIGIN=http://localhost:3000

# 로컬 PostgreSQL (docker compose). 호스트 포트는 다른 로컬 DB와 겹치지 않게 5433
POSTGRES_USER=yeoul
POSTGRES_PASSWORD=yeoul
POSTGRES_DB=true_education
POSTGRES_PORT=5433
DATABASE_URL=postgresql://yeoul:yeoul@localhost:5433/true_education?schema=public
