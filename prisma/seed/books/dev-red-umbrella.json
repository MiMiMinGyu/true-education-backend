    {
      "id": "p001",
      "sentences": [
        "아침부터 하늘이 잔뜩 흐렸어요.",
        "토끼는 빨간 우산을 들고 집을 나섰어요.",
        "학교 가는 길에 비가 주룩주룩 내리기 시작했어요."
      ]
    },
    {
      "id": "p002",
      "sentences": [
        "길모퉁이에서 거북이가 비를 맞고 서 있었어요.",
        "거북이는 우산을 깜빡 잊고 나왔대요.",
        "토끼는 거북이에게 다가가 우산을 씌워 주었어요."
      ]
    },
    {
      "id": "p003",
      "sentences": [
        "우산 하나에 둘이 쓰니 어깨가 조금 젖었어요.",
        "그래도 둘은 이야기를 나누며 천천히 걸었어요.",
        "거북이는 고마워서 활짝 웃었어요."
      ]
    },
    {
      "id": "p004",
      "sentences": [
        "학교에 도착하자 비가 그치고 무지개가 떴어요.",
        "토끼와 거북이는 나란히 무지개를 바라보았어요.",
        "토끼의 마음도 무지개처럼 알록달록 즐거웠어요."
      ]
    }
  ],
