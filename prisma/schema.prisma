// 여울(true-education) DB 스키마 — 기준 문서입니다.
// Prisma가 표현하지 못하는 제약(부분 유일 인덱스, CHECK)은 prisma/migrations/*/migration.sql에 직접 추가되어 있습니다.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------
// 1. 계정
// ---------------------------------------------------------------------

model Student {
  id                  Int      @id @default(autoincrement())
  loginId             String   @unique @map("login_id") @db.VarChar(50)
  passwordHash        String   @map("password_hash") @db.VarChar(255)
  name                String   @db.VarChar(50)
  /// 가입 시 받은 나이로 서버가 계산(현재 연도(Asia/Seoul) - 나이). CHECK 2000~2100
  birthYear           Int?     @map("birth_year") @db.SmallInt
  /// 보호자 연결용 6자리 코드(서버 발급, 대소문자 구분)
  studentCode         String   @unique @map("student_code") @db.Char(6)
  guardianShareAgreed Boolean  @default(false) @map("guardian_share_agreed")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  parents       ParentStudent[]
  assignments   BookAssignment[]
  stamps        StudentStamp[]
  parentRewards ParentReward[]
  consents      UserConsent[]

  @@map("students")
}

model Parent {
  id              Int      @id @default(autoincrement())
  loginId         String   @unique @map("login_id") @db.VarChar(50)
  passwordHash    String   @map("password_hash") @db.VarChar(255)
  name            String   @db.VarChar(50)
  termsAgreed     Boolean  @default(false) @map("terms_agreed")
  marketingAgreed Boolean  @default(false) @map("marketing_agreed")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  students ParentStudent[]
  rewards  ParentReward[]
  consents UserConsent[]

  @@map("parents")
}

/// 보호자 연결 요청 상태: 보호자가 학생 코드로 요청 → 학생이 수락해야 연결 성립
enum LinkStatus {
  PENDING
  ACCEPTED
  REJECTED
}

/// 보호자-학생 연결(요청 포함). 보호자 API는 ACCEPTED만 연결된 자녀로 봅니다.
model ParentStudent {
  parentId              Int        @map("parent_id")
  studentId             Int        @map("student_id")
  /// 자녀 개인정보 수집·이용 동의(법정대리인). 동의 시각 = createdAt(요청 시각, 다시 요청하면 갱신)
  guardianConsentAgreed Boolean    @default(false) @map("guardian_consent_agreed")
  status                LinkStatus @default(PENDING)
  /// 학생이 수락·거절한 시각
  respondedAt           DateTime?  @map("responded_at") @db.Timestamptz(6)
  createdAt             DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  parent  Parent  @relation(fields: [parentId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@id([parentId, studentId])
  @@index([studentId])
  @@map("parent_students")
}

enum ConsentSubject {
  STUDENT
  PARENT
}

/// 가입 동의 기록: 항목마다 한 행(항목 키·문구 버전·시각). 항목 목록은 src/common/constants/consent.constants.ts
/// 학생 본인 동의 = student_id만, 보호자 동의 = parent_id(+ 자녀 관련 항목이면 대상 자녀 student_id).
/// CHECK chk_consent_subject — 마이그레이션 SQL에 있음
model UserConsent {
  id          Int            @id @default(autoincrement())
  subjectType ConsentSubject @map("subject_type")
  parentId    Int?           @map("parent_id")
  studentId   Int?           @map("student_id")
  consentKey  String         @map("consent_key") @db.VarChar(50)
  version     String         @db.VarChar(20)
  agreedAt    DateTime       @default(now()) @map("agreed_at") @db.Timestamptz(6)
  /// 선택 항목 철회 시각(철회 API는 아직 없음)
  withdrawnAt DateTime?      @map("withdrawn_at") @db.Timestamptz(6)

  // 동의 기록은 증빙이라 계정을 지우려면 기록을 먼저 지워야 합니다(RESTRICT).
  parent  Parent?  @relation(fields: [parentId], references: [id], onDelete: Restrict)
  student Student? @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@index([parentId])
  @@index([studentId])
  @@map("user_consents")
}

// ---------------------------------------------------------------------
// 2. 콘텐츠 (적재 스크립트로 넣음, 모든 학생 공용)
// ---------------------------------------------------------------------

model Book {
  id            Int      @id @default(autoincrement())
  /// AI JSON의 source.story_id. 재적재 시 upsert 기준
  externalId    String   @unique @map("external_id") @db.VarChar(100)
  title         String   @db.VarChar(100)
  author        String?  @db.VarChar(100)
  sourceUrl     String?  @map("source_url")
  license       String?  @db.VarChar(200)
  bibliography  String?
  /// { paragraphs: [{ id, lines: [{ id, text, syllableCount }] }], glossary: {...} }
  content       Json
  coverImageUrl String?  @map("cover_image_url")
  /// 제목 짓기 힌트 질문(AI JSON meta.activities.titleActivity.hintQuestions, string[])
  titleHints    Json?    @map("title_hints")
  /// AI JSON meta 중 본문·문제 외 전부(출처 상세·라이선스·생성 모델·검수 상태 등). 원본 보존용
  sourceMeta    Json?    @map("source_meta")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  questions   Question[]
  ttsAudios   TtsAudio[]
  assignments BookAssignment[]

  @@map("books")
}

enum QuestionFormat {
  CHOICE
  ORDERING
}

/// 누가=WHO, 무슨 일=WHAT, 왜=WHY, 마음=EMOTION, 순서 맞추기=ORDER
enum QuestionStage {
  WHO
  WHAT
  WHY
  EMOTION
  ORDER
}

model Question {
  id             Int            @id @default(autoincrement())
  bookId         Int            @map("book_id")
  /// AI JSON의 문제 id(q1~q4), 순서 맞추기는 ORDER
  externalKey    String         @map("external_key") @db.VarChar(20)
  questionFormat QuestionFormat @map("question_format")
  stage          QuestionStage
  questionOrder  Int            @map("question_order") @db.SmallInt
  questionText   String         @map("question_text")
  /// CHOICE: ["보기1", ...] / ORDERING: [{ id: "e1", text }, ...] (정답 순서로 저장)
  options        Json
  /// CHOICE: 0부터 시작하는 보기 번호 / ORDERING: ["e1", ...]. 채점 전 응답 금지
  correctAnswer  Json           @map("correct_answer")
  hint           String?
  evidence       Json?
  /// 정답 설명. 채점 뒤(문제가 끝난 뒤)에만 응답
  explanation    String?

  book     Book              @relation(fields: [bookId], references: [id])
  attempts QuestionAttempt[]

  @@unique([bookId, externalKey])
  @@unique([bookId, questionOrder])
  @@map("questions")
}

model TtsAudio {
  id          Int      @id @default(autoincrement())
  bookId      Int      @map("book_id")
  lineId      String   @map("line_id") @db.VarChar(30)
  /// sha256(text + voice_id + model + 출력 옵션). 다르면 재생성
  contentHash String   @map("content_hash") @db.VarChar(64)
  /// 저장소 객체 키. URL은 응답 시 생성
  audioUrl    String   @map("audio_url")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  book Book @relation(fields: [bookId], references: [id])

  @@unique([bookId, lineId])
  @@map("tts_audio")
}

// ---------------------------------------------------------------------
// 3. 학습 (학생별)
// ---------------------------------------------------------------------

enum AssignmentStatus {
  IN_PROGRESS
  COMPLETED
}

enum LearningStage {
  READING
  QUESTION
  ORDERING
  TITLE
  DRAWING
  REFLECTION
  COMPLETED
}

/// 학생당 IN_PROGRESS는 1건만(부분 유일 인덱스 uq_one_in_progress_per_student),
/// status = COMPLETED ⇔ completed_at IS NOT NULL (CHECK chk_assignment_completed) — 마이그레이션 SQL에 있음
model BookAssignment {
  id           Int              @id @default(autoincrement())
  studentId    Int              @map("student_id")
  bookId       Int              @map("book_id")
  /// 배정일(Asia/Seoul). 기한 없음
  startDate    DateTime         @map("start_date") @db.Date
  studentTitle String?          @map("student_title") @db.VarChar(100)
  status       AssignmentStatus @default(IN_PROGRESS)
  completedAt  DateTime?        @map("completed_at") @db.Timestamptz(6)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  student  Student           @relation(fields: [studentId], references: [id])
  book     Book              @relation(fields: [bookId], references: [id])
  sessions LearningSession[]
  attempts QuestionAttempt[]
  progress ReadingProgress?
  drawing  Drawing?
  stamp    StudentStamp?

  @@unique([studentId, startDate])
  @@unique([studentId, bookId])
  @@index([studentId, completedAt])
  @@map("book_assignments")
}

model LearningSession {
  id                Int      @id @default(autoincrement())
  bookAssignmentId  Int      @map("book_assignment_id")
  sessionDate       DateTime @map("session_date") @db.Date
  startedAt         DateTime @default(now()) @map("started_at") @db.Timestamptz(6)
  lastActiveAt      DateTime @default(now()) @map("last_active_at") @db.Timestamptz(6)
  /// 페이지 저장마다 서버가 학생 차례 줄의 음절 수를 더함
  readSyllableCount Int      @default(0) @map("read_syllable_count")
  readingDurationMs Int      @default(0) @map("reading_duration_ms")

  assignment BookAssignment    @relation(fields: [bookAssignmentId], references: [id])
  attempts   QuestionAttempt[]

  @@unique([bookAssignmentId, sessionDate])
  @@map("learning_sessions")
}

/// attempt_number는 서버가 부여, CHECK 1~3(chk_attempt_number) — 마이그레이션 SQL에 있음
model QuestionAttempt {
  id                Int      @id @default(autoincrement())
  bookAssignmentId  Int      @map("book_assignment_id")
  learningSessionId Int      @map("learning_session_id")
  questionId        Int      @map("question_id")
  attemptNumber     Int      @map("attempt_number") @db.SmallInt
  studentAnswer     Json     @map("student_answer")
  isCorrect         Boolean  @map("is_correct")
  responseTimeMs    Int?     @map("response_time_ms")
  answeredAt        DateTime @default(now()) @map("answered_at") @db.Timestamptz(6)

  assignment BookAssignment  @relation(fields: [bookAssignmentId], references: [id])
  session    LearningSession @relation(fields: [learningSessionId], references: [id])
  question   Question        @relation(fields: [questionId], references: [id])

  @@unique([bookAssignmentId, questionId, attemptNumber])
  @@map("question_attempts")
}

model ReadingProgress {
  bookAssignmentId Int           @id @map("book_assignment_id")
  currentStage     LearningStage @default(READING) @map("current_stage")
  /// READING: 저장 완료한 페이지 수 / QUESTION: 끝낸 문제 수
  currentStep      Int           @default(0) @map("current_step") @db.SmallInt
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  assignment BookAssignment @relation(fields: [bookAssignmentId], references: [id])

  @@map("reading_progress")
}

model Drawing {
  id               Int      @id @default(autoincrement())
  bookAssignmentId Int      @unique @map("book_assignment_id")
  /// 저장소 객체 키(drawings/{assignmentId}/{uuid}.png)
  imageUrl         String   @map("image_url")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  assignment BookAssignment     @relation(fields: [bookAssignmentId], references: [id])
  reflection DrawingReflection?

  @@map("drawings")
}

/// 설명 말하기. 브라우저 음성 인식 결과(글)만 받고 음성은 서버에 오지 않습니다. CHECK duration_ms >= 0 — 마이그레이션 SQL에 있음
model DrawingReflection {
  id         Int      @id @default(autoincrement())
  drawingId  Int      @unique @map("drawing_id")
  transcript String
  /// 말한 시간(ms, 클라이언트 측정). 보호자 대시보드용
  durationMs Int      @map("duration_ms")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  drawing Drawing @relation(fields: [drawingId], references: [id])

  @@map("drawing_reflections")
}

// ---------------------------------------------------------------------
// 4. 스탬프·보상
// ---------------------------------------------------------------------

/// 책 완료 시 1개(20% 확률로 2개). CHECK amount > 0(chk_stamp_amount) — 마이그레이션 SQL에 있음
model StudentStamp {
  id               Int      @id @default(autoincrement())
  studentId        Int      @map("student_id")
  bookAssignmentId Int      @unique @map("book_assignment_id")
  amount           Int      @default(1) @db.SmallInt
  earnedAt         DateTime @default(now()) @map("earned_at") @db.Timestamptz(6)

  student    Student        @relation(fields: [studentId], references: [id])
  assignment BookAssignment @relation(fields: [bookAssignmentId], references: [id])

  @@index([studentId])
  @@map("student_stamps")
}

/// 누적 스탬프 목표치(5, 10, 15…)마다 보호자가 정한 보상 1개. CHECK required_stamps > 0 — 마이그레이션 SQL에 있음
model ParentReward {
  id             Int       @id @default(autoincrement())
  parentId       Int       @map("parent_id")
  studentId      Int       @map("student_id")
  /// 보상 목표치 = 누적 스탬프 수
  requiredStamps Int       @map("required_stamps")
  name           String    @db.VarChar(100)
  /// 보호자가 아이에게 보상을 전하고 "선물했어요"를 누른 시각(안 줬으면 NULL). 준 뒤에는 보상 글을 바꾸거나 지울 수 없음
  givenAt        DateTime? @map("given_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent  Parent  @relation(fields: [parentId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@unique([studentId, requiredStamps])
  @@map("parent_rewards")
}

enum ContentImportSource {
  API
  CLI
  /// AI 파트 파이프라인이 완성 즉시 보낸 콜백(POST /internal/ai/books) 또는 수동 복구 동기화
  PIPELINE
}

/// 재고 보충 요청 상태. PENDING·ACTIVE는 한 번에 1개만(부분 유일 인덱스 uq_one_active_refill)
enum RefillStatus {
  /// DB에 먼저 저장, AI 접수 전(같은 키·본문으로 재전송 대상)
  PENDING
  /// AI 접수됨: 생성 중이거나 완성본 전송 대기
  ACTIVE
  /// 완성본을 받아 DB에 저장함
  COMPLETED
  /// 생성 rejected/error 또는 접수 거부
  FAILED
}

/// 동화 재고 보충 요청(AI 파트 파이프라인 random 모드). 2026-09-29 AI 파트 "백엔드 연결 명세"
model ContentRefillRequest {
  /// refill-<UUID>. AI 요청의 Idempotency-Key
  id             String       @id @db.VarChar(64)
  /// AI 작업 id = sha256(id) 앞 32자(명세 규칙으로 미리 계산 → 콜백이 먼저 와도 연결됨)
  jobId          String       @unique @map("job_id") @db.VarChar(64)
  /// 보낸 본문 그대로(재전송 때 같은 본문이어야 409가 나지 않음)
  requestBody    Json         @map("request_body")
  status         RefillStatus @default(PENDING)
  /// 마지막으로 확인한 AI 작업 상태(queued·running·succeeded·rejected·error)
  aiStatus       String?      @map("ai_status") @db.VarChar(30)
  /// 마지막으로 확인한 전달 상태(pending·sending·retrying·delivered·failed·waiting_configuration)
  deliveryStatus String?      @map("delivery_status") @db.VarChar(30)
  error          String?
  bookExternalId String?      @map("book_external_id") @db.VarChar(100)
  submitAttempts Int          @default(0) @map("submit_attempts")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  finishedAt     DateTime?    @map("finished_at") @db.Timestamptz(6)

  @@index([status, finishedAt])
  @@map("content_refill_requests")
}

/// AI 파트가 보낸 완성본 수신 기록(멱등 처리). 같은 전달 키에 다른 본문이면 409
model AiBookDelivery {
  id          Int      @id @default(autoincrement())
  /// 요청 헤더 Idempotency-Key(<AI 작업 id>:<책 id>)
  deliveryKey String   @unique @map("delivery_key") @db.VarChar(250)
  jobId       String   @map("job_id") @db.VarChar(64)
  externalId  String   @map("external_id") @db.VarChar(100)
  /// 받은 본문의 sha256(hex)
  bodyHash    String   @map("body_hash") @db.Char(64)
  /// 적재 결과(CREATED·UPDATED·SKIPPED_ASSIGNED)
  status      String   @db.VarChar(20)
  receivedAt  DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  @@index([jobId])
  @@map("ai_book_deliveries")
}

/// AI 파트가 보낸 동화 JSON 원본과 처리 결과(트러블 슈팅·재적재용). 원본에 정답이 있어 공개 파일 저장소가 아닌 DB에 둡니다.
model ContentImportLog {
  id         Int                 @id @default(autoincrement())
  source     ContentImportSource
  /// 원본의 id(읽지 못했으면 NULL)
  externalId String?             @map("external_id") @db.VarChar(100)
  /// CREATED·UPDATED·SKIPPED_ASSIGNED·SKIPPED·INVALID
  status     String              @db.VarChar(20)
  errors     Json                @default("[]")
  warnings   Json                @default("[]")
  payload    Json
  receivedAt DateTime            @default(now()) @map("received_at") @db.Timestamptz(6)

  @@index([externalId])
  @@index([receivedAt])
  @@map("content_import_logs")
}

// ---------------------------------------------------------------------
// 5. 로그인 세션 저장소 (connect-pg-simple 기본 형식, 앱 코드에서 직접 쓰지 않음)
// ---------------------------------------------------------------------

model UserSession {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "idx_user_sessions_expire")
  @@map("user_sessions")
}
